<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>YouTube Video Downloader - Free MP3/MP4</title>
  <meta name="description" content="Download YouTube videos in MP3 or MP4 format. Fast, free, and secure.">
  <link rel="stylesheet" href="style.css"> <!-- Link to CSS -->
</head>
<body>
  <div class="container">
    <h1>YouTube Video Downloader</h1>
    <input type="url" id="youtubeUrl" placeholder="Paste YouTube URL here...">
    <div class="buttons">
      <button onclick="downloadVideo('mp3')">Download MP3</button>
      <button onclick="downloadVideo('mp4')">Download MP4</button>
    </div>
    <div id="result"></div>
  </div>
  <div class="disclaimer">
    <p>⚠️ Disclaimer: Only download videos you own or have permission to use.</p>
  </div>
  <script src="script.js"></script> <!-- Link to JavaScript -->
</body>
</html>